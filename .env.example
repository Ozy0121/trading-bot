# ============================================================
# TEMPLATE — copy to .env.paper and fill in your keys.
#   cp .env.example .env.paper
#
# .env.paper / .env.live / .env are gitignored. This template is NOT —
# never commit a real key into it.
#
# Alpaca paper keys: app.alpaca.markets -> top-left dropdown -> Paper -> API Keys
# ============================================================

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

PAPER_TRADING=true
DASHBOARD_PORT=5000

# ── LLM agent layer ───────────────────────────────────────────────────────
# WAS MISSING ENTIRELY. Without this, agents/strategist.py:131 and
# agents/auditor.py:125 log a warning and fall back to stubs — the whole
# multi-agent layer has been dead this entire time.
ANTHROPIC_API_KEY=
STRATEGIST_MODEL=claude-sonnet-5
AUDITOR_MODEL=claude-opus-5

# ── Market data keys ──────────────────────────────────────────────────────
# (These were labelled "OpenBB" — OpenBB was removed in commit 6aee95b and
#  replaced by data_provider.py. The keys are still used; the label was stale.)

# https://site.financialmodelingprep.com — free tier 250 req/day
FMP_API_KEY=

# https://polygon.io/dashboard/api-keys — free tier 5 req/min, 15-min delayed
POLYGON_API_KEY=

# https://finnhub.io/register — free tier 60 req/min. Not read by code yet;
# lands with the Phase 2 news work.
FINNHUB_API_KEY=

# ── Trading Configuration ─────────────────────────────────────────────────
# Fallback symbol if top movers fetch fails
SYMBOL=NVDA

# ── Top Movers Mode ───────────────────────────────────────────────────────
# Pulls Yahoo Finance's live top gainers each morning automatically.
# Set to false to use the fixed WATCHLIST below instead.
USE_TOP_MOVERS=true
TOP_MOVERS_COUNT=15

# Price/volume filters for top movers
MIN_PRICE=5.00
MAX_PRICE=500.00
MIN_VOLUME=1000000

# Fixed fallback watchlist — mixed large-cap + high-vol swing candidates
WATCHLIST=NVDA,AMD,TSLA,META,MSFT,PLTR,COIN,SOFI,HOOD,RIVN,SNAP,MARA,NIO,F

# ── SMA / Timeframe ───────────────────────────────────────────────────────
# NOTE: 9/21 on 5-minute bars is an INTRADAY signal (~45min / ~105min lookback),
# not swing. It contradicts the project's stated 1-3 day hold policy and the
# PDT day-trade budget. Flagged for review — left unchanged for now so the
# baseline backtest measures the bot as it actually runs today.
SHORT_WINDOW=9
LONG_WINDOW=21
BAR_TIMEFRAME=5Min
LOOKBACK_BARS=50
POLL_INTERVAL_SECONDS=60

# ── Safety Limits ─────────────────────────────────────────────────────────
# RESIZED for a ~$3,500 account (was $200 / 5% / $50 for a $500 account).
# Effective size = min(MAX_POSITION_VALUE, equity * MAX_POSITION_FRACTION).
# At $3,500 that is $350/position; 8 concurrent positions = 80% deployed.
MAX_POSITION_VALUE=400.00
MAX_POSITION_FRACTION=0.10

# Was $50 — only 1.4% of a $3,500 account, tight enough that ordinary noise
# would halt the bot most days. Now ~3%.
DAILY_LOSS_LIMIT=105.00

# ── High-Conviction Entry Filters ─────────────────────────────────────────
# These drive scanner.py / strategy.py — the LEGACY engine, which bot.py:679
# still consults BEFORE the prediction engine. They do not affect prediction.py.
MAX_RSI_BUY=65.0
MIN_VOLUME_RATIO=2.0

# Conviction gate for best_buy() — the actual live entry threshold.
# Was using the code default (5.8); now explicit so it can be tuned.
CONVICTION_THRESHOLD=5.8

# ── Per-Trade Exit Rules ───────────────────────────────────────────────────
# 3% trailing stop (locks in gains as stock rises), 6% take-profit.
TRAILING_STOP_PCT=0.03
TAKE_PROFIT_PCT=0.06

# NOTE: config.STOP_LOSS_PCT is read by config.py:77 and then used by NOTHING.
# backtester.py:52 has its own hardcoded 0.05, so the backtest simulates a
# different exit policy than the bot trades. Do not set this expecting an
# effect — it is on the Phase 1 fix list.

# ── Losing Streak Protection ───────────────────────────────────────────────
LOSING_STREAK_THRESHOLD=3
LOSING_STREAK_SIZE_FACTOR=0.5

# ── Expanded overnight scanner ─────────────────────────────────────────────
# Default is 10 workers; the v2 roadmap recorded yfinance throttling at 500+
# symbols and recommended 5-8.
EXPANDED_SCAN_WORKERS=6
EXPANDED_SCAN_TIMEOUT=7200
EXPANDED_SCAN_DELAY_MINUTES=15

# ── Market regime filter ───────────────────────────────────────────────────
MARKET_REGIME_ETF=SPY
MARKET_REGIME_BEARISH_MULT=0.7

# ── Account Goal ──────────────────────────────────────────────────────────
# Was 1000.0 (a 2x target on the old $500 account).
ACCOUNT_GOAL=5000.0
